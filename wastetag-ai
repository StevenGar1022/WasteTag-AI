#!/usr/bin/env bash
# WASTETAG-AI — lanzador. Arranca el CLI sin activar el entorno.
# Uso (desde la carpeta del repo):  ./wastetag-ai [flags]
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$ROOT/env/bin/python" ]; then
    echo "No existe env/. Ejecuta primero:  ./setup.sh" >&2
    exit 1
fi
exec "$ROOT/env/bin/python" "$ROOT/src/wastetag_cli.py" "$@"
